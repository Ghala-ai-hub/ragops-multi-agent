OPENAI_API_KEY=your_openai_api_key_here

# Optional observability. Leave the key empty until you receive it.
# Add your private key locally, set tracing to true, then restart Streamlit.
# Without both settings, the application runs with tracing off.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ragops-multi-agent
# Standard hosted LangSmith uses its default endpoint; no endpoint is required.
